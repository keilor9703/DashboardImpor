ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Autenticación ---
# demo  = sin validación (solo desarrollo)
# entra = valida tokens de Microsoft Entra ID
AUTH_MODE=demo
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
AZURE_API_AUDIENCE=api://<client-id-api>
# Opcional: rol de aplicación requerido (ej. Dashboard.Viewer)
AUTH_REQUIRED_ROLE=

# --- Fuente de datos: mock | graph | file ---
# file = Excel local (por defecto, el insumo del repositorio)
DATA_SOURCE=file
CACHE_TTL_SECONDS=120

# App "lectora" del Excel (client credentials, permiso Sites.Selected)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_HOSTNAME=empresa.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Operaciones
SHAREPOINT_FILE_PATH=/Documentos compartidos/Seguimiento.xlsx
EXCEL_TABLE_NAME=
EXCEL_SHEET_NAME=Sheet1
# download recomendado: el archivo tiene ~1M filas vacías con formato
GRAPH_READ_MODE=download

# Para DATA_SOURCE=file
LOCAL_FILE_PATH=../Insumos/Insumo1.xlsx

# --- Reglas de negocio ---
# TRM para convertir a USD los valores que solo existen en COP
TRM_COP_USD=4000
EUR_USD=1.08
# Las metas de lead time (PDT) por ruta están en app/data/targets.py
