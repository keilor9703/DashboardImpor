ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Autenticación ---
# demo  = sin validación (solo desarrollo)
# entra = valida tokens de Microsoft Entra ID
AUTH_MODE=demo
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
AZURE_API_AUDIENCE=api://<client-id-api>
# Opcional: rol de aplicación requerido (ej. Dashboard.Viewer)
AUTH_REQUIRED_ROLE=

# --- Fuente de datos: mock | graph | file ---
# file = Excel local (por defecto, el insumo del repositorio)
DATA_SOURCE=file
CACHE_TTL_SECONDS=120

# --- Excel en SharePoint (DATA_SOURCE=graph) · ver docs/INTEGRACION_MICROSOFT.md ---
# Si se usa la misma app del login, GRAPH_CLIENT_ID puede quedar vacío (se usa AZURE_API_CLIENT_ID)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# URL del archivo: Excel de escritorio → Archivo → Información → «Copiar ruta de acceso»
SHAREPOINT_FILE_URL=
EXCEL_SHEET_NAME=Sheet1

# Para DATA_SOURCE=file
LOCAL_FILE_PATH=../Insumos/Insumo1.xlsx

# --- Reglas de negocio ---
# TRM para convertir a USD los valores que solo existen en COP
TRM_COP_USD=4000
EUR_USD=1.08
# Las metas de lead time (PDT) por ruta están en app/data/targets.py
