# Modo de login: password (usuario y contraseña) | entra (Microsoft) | demo (sin login)
# Si se omite: entra cuando hay VITE_AZURE_CLIENT_ID, si no demo.
VITE_AUTH_MODE=
# Client ID de la app registrada en Entra ID para el frontend (SPA)
VITE_AZURE_CLIENT_ID=
# ID del tenant (directorio) de la empresa
VITE_AZURE_TENANT_ID=
# Scope expuesto por la app de la API, ej. api://<client-id-api>/Dashboard.Read
VITE_API_SCOPE=
# URL del backend en producción, ej. https://comex-dashboard-api.onrender.com (vacío = mismo dominio /api)
VITE_API_BASE_URL=
